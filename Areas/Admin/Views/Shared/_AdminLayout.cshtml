<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - لوحة تحكم المتجر (Crochet Admin)</title>
    <!-- Google Fonts: Cairo -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;600;700;800;900&display=swap" rel="stylesheet">
    <!-- Bootstrap 5 RTL -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css">
    <!-- FontAwesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        body {
            font-family: 'Cairo', sans-serif;
            background-color: #f4f6f9;
        }
        .admin-sidebar {
            min-height: 100vh;
            background-color: #2b2e38;
            color: #cfd4dc;
        }
        .admin-sidebar .nav-link {
            color: #cfd4dc;
            padding: 0.8rem 1.2rem;
            border-radius: 8px;
            margin-bottom: 4px;
            font-weight: 600;
        }
        .admin-sidebar .nav-link:hover, .admin-sidebar .nav-link.active {
            background-color: #C58B7E;
            color: #ffffff;
        }
        .admin-header {
            background-color: #ffffff;
            border-bottom: 1px solid #e1e6eb;
        }
        .admin-card {
            border: none;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.04);
            background: #ffffff;
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar -->
            <nav class="col-md-3 col-lg-2 d-md-block admin-sidebar p-3">
                <div class="d-flex align-items-center gap-2 mb-4 px-2 text-white">
                    <i class="fa-solid fa-scissors fs-4 text-warning"></i>
                    <span class="fs-5 fw-bold">إدارة الكروشيه</span>
                </div>
                <hr class="border-secondary mb-4">
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                            <i class="fa-solid fa-gauge me-2"></i> لوحة الإحصائيات
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="Admin" asp-controller="Products" asp-action="Index">
                            <i class="fa-solid fa-boxes-stacked me-2"></i> إدارة المنتجات
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="Admin" asp-controller="Categories" asp-action="Index">
                            <i class="fa-solid fa-layer-group me-2"></i> إدارة التصنيفات
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="Admin" asp-controller="Orders" asp-action="Index">
                            <i class="fa-solid fa-cart-flatbed me-2"></i> طلبات العملاء
                        </a>
                    </li>
                    <li class="nav-item mt-4">
                        <a class="nav-link text-info" asp-area="" asp-controller="Home" asp-action="Index" target="_blank">
                            <i class="fa-solid fa-arrow-up-right-from-square me-2"></i> زيارة المتجر
                        </a>
                    </li>
                    <li class="nav-item">
                        <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="mt-2">
                            <button type="submit" class="btn btn-outline-danger w-100 text-start rounded-pill">
                                <i class="fa-solid fa-right-from-bracket me-2"></i> خروج
                            </button>
                        </form>
                    </li>
                </ul>
            </nav>

            <!-- Main Content Area -->
            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 py-4">
                <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                    <h2 class="h3 fw-bold text-dark">@ViewData["Title"]</h2>
                    <span class="text-muted small">مرحباً بك، @User.Identity?.Name</span>
                </div>

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show rounded-4 mb-4" role="alert">
                        <i class="fa-solid fa-circle-check me-2"></i> @TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show rounded-4 mb-4" role="alert">
                        <i class="fa-solid fa-circle-exclamation me-2"></i> @TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @RenderBody()
            </main>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
