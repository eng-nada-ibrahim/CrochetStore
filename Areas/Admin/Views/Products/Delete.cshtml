@model CrochetStore.Models.Product
@{
    ViewData["Title"] = "تأكيد حذف المنتج";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card admin-card p-4 text-center">
            <div class="text-danger fs-1 mb-3"><i class="fa-solid fa-triangle-exclamation"></i></div>
            <h4 class="fw-bold mb-3">هل أنت متأكد من رغبتك في حذف هذا المنتج؟</h4>
            <p class="text-muted mb-4">لن تتمكن من استرجاع بيانات المنتج بعد الحذف.</p>

            <div class="border rounded-4 p-3 bg-light text-start mb-4">
                <div class="d-flex align-items-center gap-3">
                    <img src="@Model.ImageUrl" alt="@Model.Name" class="rounded-3" style="width: 70px; height: 70px; object-fit: cover;">
                    <div>
                        <h6 class="fw-bold mb-1">@Model.Name</h6>
                        <small class="text-muted d-block">التصنيف: @Model.Category?.Name</small>
                        <strong class="text-danger">@Model.Price.ToString("N0") ج.م</strong>
                    </div>
                </div>
            </div>

            <form asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <div class="d-flex justify-content-center gap-2">
                    <button type="submit" class="btn btn-danger px-4">نعم، تأكيد الحذف</button>
                    <a asp-action="Index" class="btn btn-secondary px-4">إلغاء</a>
                </div>
            </form>
        </div>
    </div>
</div>
