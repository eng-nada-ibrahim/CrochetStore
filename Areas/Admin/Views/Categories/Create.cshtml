@model CrochetStore.Models.Category
@{
    ViewData["Title"] = "إضافة تصنيف جديد";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card admin-card p-4">
            <h4 class="fw-bold mb-4 border-bottom pb-2">بيانات التصنيف الجديد</h4>

            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-bold"></label>
                    <input asp-for="Name" class="form-control" placeholder="مثال: شيلان وكوفيات">
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label fw-bold"></label>
                    <textarea asp-for="Description" class="form-control" rows="3" placeholder="وصف توضيحي للتصنيف..."></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ImageUrl" class="form-label fw-bold"></label>
                    <input asp-for="ImageUrl" class="form-control" placeholder="https://images.unsplash.com/...">
                    <span asp-validation-for="ImageUrl" class="text-danger small"></span>
                </div>

                <div class="form-check form-switch mb-4">
                    <input class="form-check-input" type="checkbox" asp-for="IsActive" checked>
                    <label class="form-check-label fw-bold" asp-for="IsActive">تفعيل التصنيف وظهوره بالمتجر</label>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary px-4">حفظ التصنيف</button>
                    <a asp-action="Index" class="btn btn-secondary">إلغاء</a>
                </div>
            </form>
        </div>
    </div>
</div>
