@model CrochetStore.Models.Category
@{
    ViewData["Title"] = "تأكيد حذف التصنيف";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card admin-card p-4 text-center">
            <div class="text-danger fs-1 mb-3"><i class="fa-solid fa-triangle-exclamation"></i></div>
            <h4 class="fw-bold mb-3">هل أنت متأكد من رغبتك في حذف التصنيف؟</h4>

            <div class="border rounded-4 p-3 bg-light text-start mb-4">
                <h5 class="fw-bold mb-1">@Model.Name</h5>
                <p class="text-muted small mb-0">@Model.Description</p>
                <div class="mt-2"><span class="badge bg-primary">يحتوي على @Model.Products.Count منتج</span></div>
            </div>

            <form asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <div class="d-flex justify-content-center gap-2">
                    <button type="submit" class="btn btn-danger px-4">نعم، تأكيد الحذف</button>
                    <a asp-action="Index" class="btn btn-secondary px-4">إلغاء</a>
                </div>
            </form>
        </div>
    </div>
</div>
