@model IEnumerable<CrochetStore.Models.Category>
@{
    ViewData["Title"] = "إدارة تصنيفات الكروشيه";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold mb-0">قائمة التصنيفات</h4>
    <a asp-action="Create" class="btn btn-primary rounded-pill px-3">
        <i class="fa-solid fa-plus me-1"></i> إضافة تصنيف جديد
    </a>
</div>

<div class="card admin-card overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>الصورة</th>
                    <th>اسم التصنيف</th>
                    <th>الوصف</th>
                    <th>عدد المنتجات</th>
                    <th>الحالة</th>
                    <th>الإجراءات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <img src="@item.ImageUrl" alt="@item.Name" class="rounded-3 border" style="width: 50px; height: 50px; object-fit: cover;">
                        </td>
                        <td><strong>@item.Name</strong></td>
                        <td><small class="text-muted">@item.Description</small></td>
                        <td>
                            <span class="badge bg-primary-subtle text-primary">@item.Products.Count منتج</span>
                        </td>
                        <td>
                            @if (item.IsActive)
                            {
                                <span class="badge bg-success">نشط</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">غير نشط</span>
                            }
                        </td>
                        <td>
                            <div class="btn-group btn-group-sm">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary" title="تعديل"><i class="fa-solid fa-pen-to-square"></i></a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger" title="حذف"><i class="fa-solid fa-trash"></i></a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
