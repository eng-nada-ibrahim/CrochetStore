@using Microsoft.AspNetCore.Identity
@using CrochetStore.Data
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - متجر كروشيه هاند ميد (Crochet Store)</title>
    <!-- Google Fonts: Cairo -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;600;700;800;900&display=swap" rel="stylesheet">
    <!-- Bootstrap 5 RTL -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css">
    <!-- FontAwesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <!-- Custom Site CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg crochet-navbar sticky-top py-3">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="fa-solid fa-heart text-danger"></i>
                    <span>غرزة & خيط <small class="fs-6 text-muted fw-normal">| Crochet Store</small></span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index"><i class="fa-solid fa-house me-1"></i> الرئيسية</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Products" asp-action="Index"><i class="fa-solid fa-store me-1"></i> معرض المنتجات</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="About"><i class="fa-solid fa-wand-magic-sparkles me-1"></i> عن المتجر والتفصيل الخاص</a>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center gap-3">
                        <!-- Shopping Cart Link -->
                        <a asp-area="" asp-controller="Cart" asp-action="Index" class="btn btn-outline-dark position-relative rounded-pill px-3">
                            <i class="fa-solid fa-cart-shopping me-1"></i> السلة
                            <span id="cartItemCount" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger d-none">
                                0
                            </span>
                        </a>

                        @if (SignInManager.IsSignedIn(User))
                        {
                            <div class="dropdown">
                                <button class="btn btn-crochet-outline dropdown-toggle" type="button" id="userMenu" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="fa-solid fa-user me-1"></i> @User.Identity?.Name
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm" aria-labelledby="userMenu">
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <li>
                                            <a class="dropdown-item fw-bold text-primary" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                                                <i class="fa-solid fa-gauge me-2"></i> لوحة تحكم الإدارة
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider"></li>
                                    }
                                    <li>
                                        <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                            <button type="submit" class="dropdown-item text-danger">
                                                <i class="fa-solid fa-arrow-right-from-bracket me-2"></i> تسجيل الخروج
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <div class="d-flex gap-2">
                                <a class="btn btn-crochet-outline" asp-area="" asp-controller="Account" asp-action="Login">دخول</a>
                                <a class="btn btn-crochet" asp-area="" asp-controller="Account" asp-action="Register">حساب جديد</a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="main-content py-4">
        <div class="container">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show rounded-4 mb-4" role="alert">
                    <i class="fa-solid fa-circle-check me-2"></i> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show rounded-4 mb-4" role="alert">
                    <i class="fa-solid fa-circle-exclamation me-2"></i> @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @RenderBody()
        </div>
    </div>

    <!-- Toast Notification for AJAX Cart actions -->
    <div class="toast-container position-fixed bottom-0 start-0 p-3" style="z-index: 1090;">
        <div id="liveToast" class="toast align-items-center border-0 shadow-lg rounded-4" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body fs-6 py-3">
                    <strong id="toastTitle" class="d-block mb-1"></strong>
                    <span id="toastBody"></span>
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    </div>

    <footer class="crochet-footer">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4">
                    <h5 class="fw-bold mb-3"><i class="fa-solid fa-heart text-danger me-2"></i> غرزة & خيط للكروشيه</h5>
                    <p class="text-light-50">
                        كل قطعة تروي قصة إبداع.. نصنع بكل فخر وحب مشغولات كروشيه يدوية راقية تناسب أناقتكم وتلبي ذوقكم الخاص مع إمكانية التعديل والتفصيل التام حسب الطلب.
                    </p>
                </div>
                <div class="col-lg-4">
                    <h6 class="fw-bold text-white mb-3">روابط سريعة</h6>
                    <ul class="list-unstyled">
                        <li class="mb-2"><a asp-controller="Products" asp-action="Index"><i class="fa-solid fa-angle-left me-1"></i> تسوق كل المنتجات</a></li>
                        <li class="mb-2"><a asp-controller="Home" asp-action="About"><i class="fa-solid fa-angle-left me-1"></i> قصة العمل اليدوي والخيوط المستخدمة</a></li>
                        <li class="mb-2"><a asp-controller="Cart" asp-action="Index"><i class="fa-solid fa-angle-left me-1"></i> سلة المشتريات</a></li>
                    </ul>
                </div>
                <div class="col-lg-4">
                    <h6 class="fw-bold text-white mb-3">طرق الدفع والتواصل</h6>
                    <p class="text-light-50 small mb-2"><i class="fa-solid fa-money-bill-wave me-2"></i> الدفع عند الاستلام (Cash on Delivery)</p>
                    <p class="text-light-50 small mb-3"><i class="fa-solid fa-mobile-screen-button me-2"></i> تحويل فودافون كاش / إنستاباي</p>
                    <div class="d-flex gap-3 fs-5">
                        <a href="#"><i class="fa-brands fa-instagram"></i></a>
                        <a href="#"><i class="fa-brands fa-facebook"></i></a>
                        <a href="#"><i class="fa-brands fa-whatsapp"></i></a>
                        <a href="#"><i class="fa-brands fa-pinterest"></i></a>
                    </div>
                </div>
            </div>
            <hr class="my-4 border-secondary opacity-25">
            <div class="text-center text-muted small">
                جميع الحقوق محفوظة &copy; @DateTime.UtcNow.Year - متجر كروشيه هاند ميد (Handmade with Love).
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
