@model CrochetStore.Models.ViewModels.ShoppingCartViewModel
@{
    ViewData["Title"] = "سلة التسوق";
}

<h2 class="fw-bold mb-4"><i class="fa-solid fa-basket-shopping text-primary me-2"></i> سلة مشترياتك اليدوية</h2>

@if (!Model.Items.Any())
{
    <div class="text-center py-5 bg-white rounded-4 border shadow-sm">
        <i class="fa-solid fa-cart-arrow-down fs-1 text-muted mb-3"></i>
        <h4 class="fw-bold">سلة التسوق فارغة حالياً</h4>
        <p class="text-muted">لم تقم بإضافة أي قطعة كروشيه إلى سلتك بعد.</p>
        <a asp-controller="Products" asp-action="Index" class="btn btn-crochet px-4 py-2 mt-2">
            <i class="fa-solid fa-bag-shopping me-2"></i> تصفح معرض المنتجات
        </a>
    </div>
}
else
{
    <div class="row g-4">
        <!-- Cart Items List -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>المنتج</th>
                                <th>المقاس</th>
                                <th>السعر</th>
                                <th style="width: 130px;">الكمية</th>
                                <th>الإجمالي</th>
                                <th>حذف</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-3">
                                            <img src="@(item.ProductImage ?? "https://via.placeholder.com/80")" alt="@item.ProductName" class="rounded-3" style="width: 60px; height: 60px; object-fit: cover;">
                                            <div>
                                                <h6 class="fw-bold mb-0">
                                                    <a asp-controller="Products" asp-action="Details" asp-route-id="@item.ProductId" class="text-dark text-decoration-none">
                                                        @item.ProductName
                                                    </a>
                                                </h6>
                                                <small class="text-muted"><i class="fa-solid fa-feather me-1"></i> @item.YarnType</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.SelectedSize))
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary border rounded-pill mb-1">@item.SelectedSize</span>
                                        }
                                        @if (!string.IsNullOrEmpty(item.CustomNotes))
                                        {
                                            <p class="small text-muted mb-0 fst-italic">ملاحظة: @item.CustomNotes</p>
                                        }
                                    </td>
                                    <td>@item.Price.ToString("N0") ج.م</td>
                                    <td>
                                        <input type="number" class="form-control form-control-sm text-center quantity-input" 
                                               value="@item.Quantity" min="1" max="50"
                                               data-product-id="@item.ProductId"
                                               data-selected-size="@item.SelectedSize"
                                               onchange="updateItemQty(this)">
                                    </td>
                                    <td class="fw-bold text-danger">@item.TotalPrice.ToString("N0") ج.م</td>
                                    <td>
                                        <form asp-action="RemoveItem" method="post" class="d-inline">
                                            <input type="hidden" name="productId" value="@item.ProductId" />
                                            <input type="hidden" name="selectedSize" value="@item.SelectedSize" />
                                            <button type="submit" class="btn btn-sm text-danger btn-light rounded-circle" title="حذف">
                                                <i class="fa-solid fa-trash-can"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="mt-3">
                <a asp-controller="Products" asp-action="Index" class="btn btn-crochet-outline">
                    <i class="fa-solid fa-arrow-right me-2"></i> مواصلة التسوق
                </a>
            </div>
        </div>

        <!-- Summary -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 p-4">
                <h5 class="fw-bold mb-3 border-bottom pb-2">ملخص الحساب</h5>
                
                <div class="d-flex justify-content-between mb-2">
                    <span>إجمالي المشغولات:</span>
                    <strong id="subTotalDisplay">@Model.SubTotal.ToString("N0") ج.م</strong>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span>مصاريف الشحن:</span>
                    <strong id="shippingDisplay">@Model.ShippingCost.ToString("N0") ج.م</strong>
                </div>
                <div class="d-flex justify-content-between mb-3 border-top pt-2">
                    <span class="fs-5 fw-bold">الإجمالي الكلي:</span>
                    <span class="fs-5 fw-bold text-danger" id="grandTotalDisplay">@Model.GrandTotal.ToString("N0") ج.م</span>
                </div>

                <div class="alert alert-light border rounded-3 p-3 small mb-4">
                    <i class="fa-solid fa-clock-rotate-left text-warning me-1"></i>
                    أقصى مدة تجهيز مطلوبة لهذه الطلبية: <strong>@Model.MaxProcessingDays أيام عمل</strong> قبل الشحن.
                </div>

                <a asp-action="Checkout" class="btn btn-crochet btn-lg w-100 py-3 shadow">
                    <i class="fa-solid fa-credit-card me-2"></i> إتمام الطلب الآن
                </a>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        function updateItemQty(input) {
            const prodId = $(input).data('product-id');
            const size = $(input).data('selected-size');
            const qty = parseInt($(input).val());

            if (qty <= 0) return;

            $.post('/Cart/UpdateQuantity', { productId: prodId, selectedSize: size, quantity: qty }, function (res) {
                if (res.success) {
                    location.reload();
                }
            });
        }
    </script>
}
