@model CrochetStore.Models.Product
@{
    ViewData["Title"] = Model.Name;
    var sizes = (Model.SizeOptions ?? "S, M, L, XL, تفصيل خاص").Split(new[] { ',', '،' }, StringSplitOptions.RemoveEmptyEntries);
    var relatedProducts = ViewBag.RelatedProducts as List<CrochetStore.Models.Product> ?? new List<CrochetStore.Models.Product>();
}

<nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">الرئيسية</a></li>
        <li class="breadcrumb-item"><a asp-controller="Products" asp-action="Index">المعرض</a></li>
        <li class="breadcrumb-item"><a asp-controller="Products" asp-action="Index" asp-route-categoryId="@Model.CategoryId">@Model.Category?.Name</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
    </ol>
</nav>

<div class="card border-0 shadow-sm rounded-4 p-4 mb-5">
    <div class="row g-4">
        <!-- Product Image -->
        <div class="col-lg-6">
            <div class="rounded-4 overflow-hidden shadow-sm border text-center bg-light">
                <img src="@Model.ImageUrl" alt="@Model.Name" class="img-fluid w-100" style="max-height: 480px; object-fit: cover;">
            </div>
        </div>

        <!-- Product Purchase Information -->
        <div class="col-lg-6">
            <span class="badge badge-crochet mb-2">@Model.Category?.Name</span>
            <h2 class="fw-bold mb-3">@Model.Name</h2>

            <div class="d-flex align-items-center gap-3 mb-3">
                <h3 class="text-danger fw-bold mb-0">@Model.Price.ToString("N0") ج.م</h3>
                @if (Model.StockQuantity > 0)
                {
                    <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill">متوفر بالمخزن (@Model.StockQuantity قطعة)</span>
                }
                else
                {
                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-3 py-2 rounded-pill">يتم التنفيذ حسب الطلب</span>
                }
            </div>

            <p class="text-muted lead fs-6 mb-4">@Model.Description</p>

            <!-- Handmade Craft Details Specs -->
            <div class="bg-light p-3 rounded-4 mb-4 border">
                <div class="row g-3">
                    <div class="col-sm-6">
                        <div class="d-flex align-items-center gap-2">
                            <i class="fa-solid fa-feather text-primary fs-5"></i>
                            <div>
                                <small class="text-muted d-block">نوع الخيط المستخدم</small>
                                <strong>@Model.YarnType</strong>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="d-flex align-items-center gap-2">
                            <i class="fa-solid fa-hourglass-half text-warning fs-5"></i>
                            <div>
                                <small class="text-muted d-block">مدة التنفيذ والتجهيز اليدوي</small>
                                <strong>يحتاج @Model.ProcessingDays إلى @(Model.ProcessingDays + 2) أيام عمل</strong>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="d-flex align-items-center gap-2">
                            <i class="fa-solid fa-wand-magic-sparkles text-danger fs-5"></i>
                            <div>
                                <small class="text-muted d-block">التفصيل والتعديل</small>
                                <strong>@(Model.IsCustomizable ? "متاح تغيير الألوان والمقاسات" : "حسب المعروض")</strong>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="d-flex align-items-center gap-2">
                            <i class="fa-solid fa-gift text-success fs-5"></i>
                            <div>
                                <small class="text-muted d-block">التغليف</small>
                                <strong>تغليف هدايا أنيق مجاني</strong>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Custom Order Options & Add to Cart -->
            <form id="addToCartForm" onsubmit="event.preventDefault(); submitAddToCart();">
                <input type="hidden" id="productId" value="@Model.Id" />

                <!-- Size Selection -->
                <div class="mb-3">
                    <label class="form-label fw-bold">اختر المقاس:</label>
                    <div class="d-flex flex-wrap gap-2">
                        @for (int i = 0; i < sizes.Length; i++)
                        {
                            var size = sizes[i].Trim();
                            <div class="form-check form-check-inline m-0">
                                <input class="btn-check" type="radio" name="selectedSize" id="size_@i" value="@size" @(i == 0 ? "checked" : "")>
                                <label class="btn btn-outline-secondary rounded-pill px-3" for="size_@i">@size</label>
                            </div>
                        }
                    </div>
                </div>

                <!-- Custom Notes Input -->
                <div class="mb-3">
                    <label class="form-label fw-bold">
                        ملاحظات أو تخصيص يدوي <small class="text-muted fw-normal">(ألوان مفضلة، طول محدد بالسم، أو إهداء خاص)</small>:
                    </label>
                    <textarea id="customNotes" class="form-control rounded-3" rows="2" placeholder="اكتب هنا أي تفاصيل تريدها في قطعتك الخاصة..."></textarea>
                </div>

                <!-- Quantity & Action -->
                <div class="row g-2 align-items-center">
                    <div class="col-sm-4">
                        <div class="input-group">
                            <span class="input-group-text bg-white">الكمية</span>
                            <input type="number" id="quantity" class="form-control text-center" value="1" min="1" max="50">
                        </div>
                    </div>
                    <div class="col-sm-8">
                        <button type="submit" id="btnAddToCart" class="btn btn-crochet w-100 py-2 fs-6">
                            <i class="fa-solid fa-cart-plus me-2"></i> إضافة إلى السلة
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Related Products -->
@if (relatedProducts.Any())
{
    <div class="mb-5">
        <h4 class="fw-bold mb-4">مشغولات مشابهة قد تنال إعجابك</h4>
        <div class="row g-4">
            @foreach (var p in relatedProducts)
            {
                <div class="col-6 col-md-3">
                    <div class="crochet-card h-100">
                        <img src="@p.ImageUrl" alt="@p.Name">
                        <div class="p-3">
                            <h6 class="fw-bold mb-1">
                                <a asp-controller="Products" asp-action="Details" asp-route-id="@p.Id" class="text-dark text-decoration-none">
                                    @p.Name
                                </a>
                            </h6>
                            <span class="text-danger fw-bold">@p.Price.ToString("N0") ج.م</span>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}

@section Scripts {
    <script>
        function submitAddToCart() {
            const prodId = $('#productId').val();
            const qty = $('#quantity').val();
            const size = $('input[name="selectedSize"]:checked').val() || '';
            const notes = $('#customNotes').val();
            const btn = document.getElementById('btnAddToCart');

            addToCart(prodId, qty, size, notes, btn);
        }
    </script>
}
