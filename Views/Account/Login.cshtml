@model CrochetStore.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "تسجيل الدخول";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
            <div class="text-center mb-4">
                <div class="fs-1 text-primary mb-2"><i class="fa-solid fa-lock"></i></div>
                <h3 class="fw-bold">تسجيل الدخول</h3>
                <p class="text-muted small">أهلاً بك مجدداً في متجر الكروشيه</p>
            </div>

            <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-bold"></label>
                    <input asp-for="Email" class="form-control rounded-pill" placeholder="name@example.com">
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label fw-bold"></label>
                    <input asp-for="Password" class="form-control rounded-pill" placeholder="••••••••">
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="form-check mb-4">
                    <input class="form-check-input ms-2" type="checkbox" asp-for="RememberMe">
                    <label class="form-check-label small" asp-for="RememberMe">تذكر تسجيل دخولي</label>
                </div>

                <button type="submit" class="btn btn-crochet w-100 py-2 rounded-pill shadow-sm mb-3">
                    تسجيل الدخول
                </button>

               @*  <div class="alert alert-light border small text-center p-2 mb-3">
                    <strong>بيانات الأدمن الافتراضية:</strong><br/>
                    admin@crochetstore.com | Admin@123456
                </div> *@

                <div class="text-center small">
                    ليس لديك حساب؟ <a asp-action="Register" class="fw-bold text-primary text-decoration-none">إنشاء حساب جديد</a>
                </div>
            </form>
        </div>
    </div>
</div>
